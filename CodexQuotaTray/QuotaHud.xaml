<Window x:Class="CodexQuotaTray.QuotaHud"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CodexQuotaTray"
        Title="QuotaTray 额度一览"
        SizeToContent="WidthAndHeight"
        AllowsTransparency="True" WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent" ShowInTaskbar="False" Topmost="True"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Deactivated="Window_OnDeactivated" IsVisibleChanged="Window_OnIsVisibleChanged"
        PreviewKeyDown="Window_OnPreviewKeyDown">
    <Window.ContextMenu>
        <ContextMenu x:Name="Actions" Closed="Actions_OnClosed">
            <MenuItem Header="贴靠左边" Tag="{x:Static local:HudEdge.Left}" Click="Dock_OnClick"/>
            <MenuItem Header="贴靠右边" Tag="{x:Static local:HudEdge.Right}" Click="Dock_OnClick"/>
            <MenuItem Header="贴靠上边" Tag="{x:Static local:HudEdge.Top}" Click="Dock_OnClick"/>
            <MenuItem Header="贴靠下边" Tag="{x:Static local:HudEdge.Bottom}" Click="Dock_OnClick"/>
            <Separator/>
            <MenuItem x:Name="Pin" Header="固定在桌面" IsCheckable="True"/>
            <MenuItem Header="收起浮窗" Click="Close_OnClick"/>
        </ContextMenu>
    </Window.ContextMenu>
    <Window.Resources>
        <Style x:Key="ReadingButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="3,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ToolTipService.Placement" Value="Right"/>
            <Setter Property="ToolTipService.HorizontalOffset" Value="6"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="220"/>
            <Setter Property="ToolTipService.ShowDuration" Value="15000"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                                CornerRadius="7" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="#26344C"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="#879BB9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding LayoutEdge, RelativeSource={RelativeSource AncestorType=local:QuotaHud}}" Value="{x:Static local:HudEdge.Right}">
                    <Setter Property="ToolTipService.Placement" Value="Left"/>
                    <Setter Property="ToolTipService.HorizontalOffset" Value="-6"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding LayoutEdge, RelativeSource={RelativeSource AncestorType=local:QuotaHud}}" Value="{x:Static local:HudEdge.Top}">
                    <Setter Property="ToolTipService.Placement" Value="Bottom"/>
                    <Setter Property="ToolTipService.HorizontalOffset" Value="0"/>
                    <Setter Property="ToolTipService.VerticalOffset" Value="6"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding LayoutEdge, RelativeSource={RelativeSource AncestorType=local:QuotaHud}}" Value="{x:Static local:HudEdge.Bottom}">
                    <Setter Property="ToolTipService.Placement" Value="Top"/>
                    <Setter Property="ToolTipService.HorizontalOffset" Value="0"/>
                    <Setter Property="ToolTipService.VerticalOffset" Value="-6"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SourceTip" TargetType="ToolTip">
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/>
            <Setter Property="Foreground" Value="#E0E7F3"/>
            <Setter Property="MaxWidth" Value="258"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="#151E2E" BorderBrush="#425372" BorderThickness="1"
                                CornerRadius="10" Padding="11,8">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border x:Name="HudBody" Background="#D1000000" BorderBrush="#24FFFFFF"
            BorderThickness="1" CornerRadius="15" Padding="4"
            MouseEnter="HudBody_OnMouseEnter" MouseLeave="HudBody_OnMouseLeave">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding LayoutEdge, RelativeSource={RelativeSource AncestorType=local:QuotaHud}}" Value="{x:Static local:HudEdge.Left}">
                        <Setter Property="HorizontalAlignment" Value="Left"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding LayoutEdge, RelativeSource={RelativeSource AncestorType=local:QuotaHud}}" Value="{x:Static local:HudEdge.Top}">
                        <Setter Property="HorizontalAlignment" Value="Center"/>
                        <Setter Property="VerticalAlignment" Value="Top"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding LayoutEdge, RelativeSource={RelativeSource AncestorType=local:QuotaHud}}" Value="{x:Static local:HudEdge.Bottom}">
                        <Setter Property="HorizontalAlignment" Value="Center"/>
                        <Setter Property="VerticalAlignment" Value="Bottom"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <DockPanel>
            <Border x:Name="Grip" Width="5" DockPanel.Dock="Left" Background="Transparent" Cursor="SizeAll"
                    ToolTip="拖动贴靠屏幕边沿 · 右键打开选项" MouseLeftButtonDown="Grip_OnMouseLeftButtonDown">
                <Border x:Name="GripMark" Width="2" Height="24" CornerRadius="1" Background="#637594" Visibility="Hidden"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ItemsControl x:Name="SourceRows">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LayoutEdge, RelativeSource={RelativeSource AncestorType=local:QuotaHud}}" Value="{x:Static local:HudEdge.Top}">
                                            <Setter Property="Orientation" Value="Horizontal"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LayoutEdge, RelativeSource={RelativeSource AncestorType=local:QuotaHud}}" Value="{x:Static local:HudEdge.Bottom}">
                                            <Setter Property="Orientation" Value="Horizontal"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                        </StackPanel>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource ReadingButton}" Click="Source_OnClick"
                                AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding Summary.Details}">
                            <Button.ToolTip>
                                <ToolTip Style="{StaticResource SourceTip}"
                                         DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="{Binding Summary.Details}" TextWrapping="Wrap" Margin="0,3,0,0" FontSize="12"/>
                                    </StackPanel>
                                </ToolTip>
                            </Button.ToolTip>
                            <DockPanel x:Name="Reading" Width="38" Height="39">
                                <Grid x:Name="Badge" DockPanel.Dock="Left" Width="32" Height="32"
                                      Margin="0,0,6,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <local:QuotaRing Accent="{Binding StatusBrush}" Fraction="{Binding Summary.Fraction, TargetNullValue=0}"/>
                                    <Image Source="{Binding Icon}" Width="18" Height="18" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <Viewbox x:Name="Readout" Height="25" StretchDirection="DownOnly"
                                         VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock Text="{Binding Summary.Value}" Foreground="{Binding StatusBrush}"
                                               FontSize="21" Typography.NumeralAlignment="Tabular"/>
                                </Viewbox>
                            </DockPanel>
                        </Button>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=local:QuotaHud}}" Value="True">
                                <Setter TargetName="Reading" Property="Width" Value="85"/>
                                <Setter TargetName="Readout" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding LayoutEdge, RelativeSource={RelativeSource AncestorType=local:QuotaHud}}" Value="{x:Static local:HudEdge.Right}">
                                <Setter TargetName="Badge" Property="DockPanel.Dock" Value="Right"/>
                                <Setter TargetName="Badge" Property="Margin" Value="6,0,0,0"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding LayoutEdge, RelativeSource={RelativeSource AncestorType=local:QuotaHud}}" Value="{x:Static local:HudEdge.Top}">
                                <Setter TargetName="Reading" Property="Width" Value="51"/>
                                <Setter TargetName="Reading" Property="Height" Value="35"/>
                                <Setter TargetName="Badge" Property="DockPanel.Dock" Value="Top"/>
                                <Setter TargetName="Badge" Property="Margin" Value="0,0,0,3"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding LayoutEdge, RelativeSource={RelativeSource AncestorType=local:QuotaHud}}" Value="{x:Static local:HudEdge.Bottom}">
                                <Setter TargetName="Reading" Property="Width" Value="51"/>
                                <Setter TargetName="Reading" Property="Height" Value="35"/>
                                <Setter TargetName="Badge" Property="DockPanel.Dock" Value="Bottom"/>
                                <Setter TargetName="Badge" Property="Margin" Value="0,3,0,0"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding LayoutEdge, RelativeSource={RelativeSource AncestorType=local:QuotaHud}}" Value="{x:Static local:HudEdge.Top}"/>
                                    <Condition Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=local:QuotaHud}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Reading" Property="Height" Value="60"/>
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding LayoutEdge, RelativeSource={RelativeSource AncestorType=local:QuotaHud}}" Value="{x:Static local:HudEdge.Bottom}"/>
                                    <Condition Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=local:QuotaHud}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Reading" Property="Height" Value="60"/>
                            </MultiDataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>
    </Border>
</Window>
