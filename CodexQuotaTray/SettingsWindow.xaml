<Window x:Class="CodexQuotaTray.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuotaTray 设置" Width="512" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13" Foreground="#182537"
        Background="#F4F6FA" UseLayoutRounding="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhen"/>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#526479"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#DCE2EB"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="7,0"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Frame" CornerRadius="6" Background="#E8EDF4" BorderBrush="Transparent" BorderThickness="1" Padding="4,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#DAE5F3"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="#284D7E"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#2888DA"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="19,0"/>
            <Setter Property="Foreground" Value="#24364C"/>
            <Setter Property="Background" Value="#E7ECF3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="6" BorderThickness="2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.85"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.72"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#3990E0"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Background="#F4F6FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="额度设置" FontSize="24" FontWeight="SemiBold" Margin="22,18,22,12"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="22,0,22,14">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="托盘图标与账号" Style="{StaticResource Section}"/>
                        <UniformGrid Rows="1" Columns="3" Margin="-2,0">
                            <RadioButton x:Name="CodexSource" GroupName="Source" Content="Codex"/>
                            <RadioButton x:Name="VolcanoSource" GroupName="Source" Content="火山引擎"/>
                            <RadioButton x:Name="AntigravitySource" GroupName="Source" Content="Antigravity"/>
                        </UniformGrid>
                        <StackPanel Margin="0,14,0,0" Visibility="{Binding IsChecked, ElementName=CodexSource, Converter={StaticResource VisibleWhen}}">
                            <TextBlock Style="{StaticResource Hint}" Text="使用这台电脑的 Codex 登录。仅在使用自定义目录时填写下方路径。"/>
                            <Label Content="Codex 主目录（选填）" Target="{Binding ElementName=CodexHomeBox}" Padding="0" Margin="0,10,0,4"/>
                            <TextBox x:Name="CodexHomeBox"/>
                        </StackPanel>
                        <StackPanel Margin="0,14,0,0" Visibility="{Binding IsChecked, ElementName=VolcanoSource, Converter={StaticResource VisibleWhen}}">
                            <TextBlock Text="个人版 Agent Plan" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" Text="使用有方舟用量读取权限的 IAM 访问密钥。查询账户余额还需 billing:QueryBalanceAcct 权限。"/>
                            <CheckBox x:Name="ReplaceKeys" Content="更换已保存的密钥" Margin="0,10,0,0" VerticalContentAlignment="Center"/>
                            <StackPanel Visibility="{Binding IsChecked, ElementName=ReplaceKeys, Converter={StaticResource VisibleWhen}}">
                                <Label Content="密钥 ID（Access Key ID）" Target="{Binding ElementName=AccessKeyIdBox}" Padding="0" Margin="0,10,0,4"/>
                                <TextBox x:Name="AccessKeyIdBox"/>
                                <Label Content="访问密钥（Secret Access Key）" Target="{Binding ElementName=SecretAccessKeyBox}" Padding="0" Margin="0,9,0,4"/>
                                <PasswordBox x:Name="SecretAccessKeyBox" Height="32" Padding="7,0" VerticalContentAlignment="Center"/>
                                <TextBlock Style="{StaticResource Hint}" FontSize="12" Margin="0,6,0,0" Text="Secret 由当前 Windows 用户加密保存在本机。"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Margin="0,14,0,0" Style="{StaticResource Hint}" Visibility="{Binding IsChecked, ElementName=AntigravitySource, Converter={StaticResource VisibleWhen}}"
                                   Text="登录并运行本机 Antigravity 桌面端即可查看额度。近 7 天用量来自本机会话记录。"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="刷新与托盘提示" Style="{StaticResource Section}"/>
                        <DockPanel LastChildFill="False">
                            <Label Content="刷新间隔" Target="{Binding ElementName=RefreshSecondsBox}" Padding="0" VerticalAlignment="Center"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <TextBox x:Name="RefreshSecondsBox" Width="70" HorizontalContentAlignment="Center"/>
                                <TextBlock Text="秒" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>
                        <DockPanel LastChildFill="False" Margin="0,10,0,0">
                            <Label Content="托盘显示的重置时间" Target="{Binding ElementName=TooltipResetWindowCombo}" Padding="0" VerticalAlignment="Center"/>
                            <ComboBox DockPanel.Dock="Right" x:Name="TooltipResetWindowCombo" Width="126" Height="32" VerticalContentAlignment="Center" Padding="8,2">
                                <ComboBoxItem Content="5 小时额度"/><ComboBoxItem Content="周额度"/>
                            </ComboBox>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="White" BorderBrush="#DCE2EB" BorderThickness="0,1,0,0" Padding="22,12">
            <StackPanel>
                <TextBlock x:Name="ValidationMessage" Visibility="Collapsed" Foreground="#9F3024" TextWrapping="Wrap" Margin="0,0,0,8" AutomationProperties.LiveSetting="Assertive"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" IsCancel="True" Margin="0,0,8,0"/>
                    <Button Content="保存设置" Foreground="White" Background="#284D7E" IsDefault="True" Click="SaveButton_OnClick"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
