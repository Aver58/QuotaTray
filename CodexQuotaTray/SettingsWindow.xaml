<Window x:Class="CodexQuotaTray.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CodexQuotaTray Settings"
        Width="520"
        Height="530"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#10131A"
        Foreground="#F3F6FA">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Settings" FontSize="25" FontWeight="Bold" />
        <TextBlock Grid.Row="1"
                   Text="Choose the quota source and refresh interval."
                   Foreground="#AEB8C6"
                   Margin="0,6,0,22" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Quota source" FontWeight="SemiBold" Margin="0,0,0,7" />
                <ComboBox x:Name="SourceCombo" Height="34" SelectedIndex="0">
                    <ComboBoxItem Content="Codex" />
                    <ComboBoxItem Content="Volcano Engine · Agent Plan (Personal)" />
                    <ComboBoxItem Content="Antigravity" />
                </ComboBox>

                <TextBlock Text="Refresh interval (seconds)" FontWeight="SemiBold" Margin="0,18,0,7" />
                <TextBox x:Name="RefreshSecondsBox" Height="34" Padding="8,5" />

                <TextBlock Text="Tray tooltip reset time" FontWeight="SemiBold" Margin="0,18,0,7" />
                <ComboBox x:Name="TooltipResetWindowCombo" Height="34" SelectedIndex="0">
                    <ComboBoxItem Content="5h reset time" />
                    <ComboBoxItem Content="Week reset time" />
                </ComboBox>

                <TextBlock Text="Codex home (optional)" FontWeight="SemiBold" Margin="0,18,0,7" />
                <TextBox x:Name="CodexHomeBox" Height="34" Padding="8,5" />

                <Border Background="#181F2A" CornerRadius="10" Padding="14" Margin="0,22,0,0">
                    <StackPanel>
                        <TextBlock Text="Volcano Engine Access Key" FontSize="16" FontWeight="Bold" />
                        <TextBlock Text="Use an IAM Access Key with read permission for Ark Agent Plan usage. The Agent Plan model API key is not the same credential."
                                   TextWrapping="Wrap"
                                   Foreground="#AEB8C6"
                                   Margin="0,6,0,14" />
                        <TextBlock Text="Access Key ID" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBox x:Name="AccessKeyIdBox" Height="34" Padding="8,5" />
                        <TextBlock Text="Secret Access Key" FontWeight="SemiBold" Margin="0,13,0,6" />
                        <PasswordBox x:Name="SecretAccessKeyBox" Height="34" Padding="8,5" />
                        <TextBlock Text="The secret is encrypted for this Windows user before it is saved locally."
                                   TextWrapping="Wrap"
                                   Foreground="#7F8A9A"
                                   FontSize="11"
                                   Margin="0,9,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Cancel" Width="100" Height="36" Margin="0,0,10,0" IsCancel="True" />
            <Button Content="Save" Width="100" Height="36" IsDefault="True" Click="SaveButton_OnClick" />
        </StackPanel>
    </Grid>
</Window>
