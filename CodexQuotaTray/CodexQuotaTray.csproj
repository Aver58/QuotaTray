<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>0.5.7</Version>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CodexQuotaCore\CodexQuotaCore.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(PublishSingleFile)' == 'true' And '$(SelfContained)' == 'false'">
    <AssemblyMetadata Include="QuotaTrayPackageFlavor" Value="Lightweight" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="ApplyUpdate.ps1" LogicalName="CodexQuotaTray.ApplyUpdate.ps1" />
    <EmbeddedResource Include="Assets\Providers\NOTICE.txt" LogicalName="CodexQuotaTray.ProviderNotices.txt" />
    <Resource Include="Assets\Providers\*.png" />
  </ItemGroup>
</Project>
