<UserControl x:Class="CodexQuotaTray.AntigravityPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="#F3F6FA">
    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AEB8C6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="36"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Quota remaining" Style="{StaticResource SectionTitle}"/>
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="{Binding Name}" FontSize="19" FontWeight="Bold"/>
                            <ItemsControl ItemsSource="{Binding Windows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,5,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/><RowDefinition Height="5"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{Binding Period}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Reset}" Foreground="#AEB8C6" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Remaining}" Margin="8,0,0,0" FontSize="20" FontWeight="Bold"/>
                                            <Border Grid.Row="1" Grid.ColumnSpan="3" Background="#364539" CornerRadius="2"/>
                                            <Border Grid.Row="1" Grid.ColumnSpan="3" Background="#46EA63" CornerRadius="2">
                                                <Border.RenderTransform><ScaleTransform ScaleX="{Binding Fraction}"/></Border.RenderTransform>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
        <StackPanel Grid.Column="2">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="68"/><ColumnDefinition Width="68"/></Grid.ColumnDefinitions>
                <TextBlock Text="Quota used" Style="{StaticResource SectionTitle}"/>
                <TextBlock Grid.Column="1" Text="5h" HorizontalAlignment="Right" Style="{StaticResource SectionTitle}"/>
                <TextBlock Grid.Column="2" Text="Week" HorizontalAlignment="Right" Style="{StaticResource SectionTitle}"/>
            </Grid>
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="68"/><ColumnDefinition Width="68"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Windows[0].Used}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="2" Text="{Binding Windows[1].Used}" HorizontalAlignment="Right"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Daily tokens · Last 7 days" Style="{StaticResource SectionTitle}" Margin="0,14,0,5"/>
            <ItemsControl ItemsSource="{Binding Days}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="21">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="47"/><ColumnDefinition/><ColumnDefinition Width="Auto" MinWidth="68"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Date}" Foreground="#AEB8C6" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="#202A3A" Height="5" CornerRadius="2"/>
                            <Border Grid.Column="1" Background="#488CE3" Height="5" CornerRadius="2">
                                <Border.RenderTransform><ScaleTransform ScaleX="{Binding Fraction}"/></Border.RenderTransform>
                            </Border>
                            <TextBlock Grid.Column="2" Text="{Binding Tokens}" Margin="8,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding Notice}" Foreground="#AEB8C6" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>
        <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Status}" Foreground="#8C98A8" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
    </Grid>
</UserControl>
