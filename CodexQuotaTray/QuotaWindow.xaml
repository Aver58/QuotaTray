<Window x:Class="CodexQuotaTray.QuotaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CodexQuotaTray"
        Width="680"
        Height="360"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        PreviewMouseLeftButtonDown="Window_OnPreviewMouseLeftButtonDown"
        Deactivated="Window_OnDeactivated">
    <Border CornerRadius="28" Background="#10131A" BorderBrush="#202734" BorderThickness="1" Padding="34,26,34,24">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button x:Name="CloseButton"
                    Panel.ZIndex="1"
                    Width="30"
                    Height="30"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Grid.ColumnSpan="2"
                    Content="×"
                    ToolTip="收起面板" AutomationProperties.Name="收起面板"
                    Foreground="#C7CFDA"
                    Background="#18202B"
                    BorderBrush="#303A48"
                    FontWeight="Bold"
                    Click="CloseButton_OnClick" />

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top">
                    <Border Width="58" Height="48" CornerRadius="18" Background="#F8FAFC">
                        <TextBlock Text="&gt;_"
                                   Foreground="#10131A"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="SourceTitleText"
                               Text="Codex"
                               Foreground="#F3F6FA"
                               FontSize="30"
                               FontWeight="Bold"
                               Margin="18,5,0,0" />
                </StackPanel>

            <StackPanel x:Name="StandardQuotaPanel" Grid.Column="0" Margin="0,70,0,0">
                <Grid Width="238" Margin="0,0,0,2">
                    <TextBlock x:Name="PrimaryLabelText" Text="5 小时" Foreground="#F3F6FA" FontSize="24" FontWeight="Bold" />
                    <TextBlock x:Name="PrimaryPercentText"
                               Text="--"
                               Foreground="#F3F6FA"
                               FontSize="38"
                               FontWeight="Bold"
                               HorizontalAlignment="Right"
                               Margin="0,-7,0,0" />
                </Grid>
                <StackPanel x:Name="PrimaryProgressDetails">
                    <Grid Width="238" Height="12" ClipToBounds="True" Margin="0,1,0,4">
                        <Border Background="#405043" CornerRadius="6" />
                        <Border x:Name="PrimaryFill" Width="0" HorizontalAlignment="Left" Background="#46EA63" CornerRadius="6" />
                    </Grid>
                    <TextBlock x:Name="PrimaryResetText" Text="--" Foreground="#747E8D" FontSize="11" Margin="6,0,0,18" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Grid Width="238" Margin="0,0,0,2">
                    <TextBlock x:Name="SecondaryLabelText" Text="周额度" Foreground="#F3F6FA" FontSize="24" FontWeight="Bold" />
                    <TextBlock x:Name="SecondaryPercentText"
                               Text="--%"
                               Foreground="#F3F6FA"
                               FontSize="38"
                               FontWeight="Bold"
                               HorizontalAlignment="Right"
                               Margin="0,-7,0,0" />
                </Grid>
                <Grid Width="238" Height="12" ClipToBounds="True" Margin="0,1,0,4">
                    <Border Background="#405043" CornerRadius="6" />
                    <Border x:Name="SecondaryFill" Width="0" HorizontalAlignment="Left" Background="#46EA63" CornerRadius="6" />
                </Grid>
                <Grid Width="238">
                    <TextBlock x:Name="SecondaryResetText" Text="--" Foreground="#747E8D" FontSize="11" Margin="6,0,0,0" TextTrimming="CharacterEllipsis" />
                </Grid>

                <StackPanel x:Name="AgentPlanExtraWindows" Visibility="Collapsed" Margin="0,18,0,0">
                    <StackPanel x:Name="DailyQuotaPanel">
                        <Grid Width="238" Margin="0,0,0,2">
                            <TextBlock x:Name="DailyLabelText" Text="日额度" Foreground="#F3F6FA" FontSize="20" FontWeight="Bold" />
                            <TextBlock x:Name="DailyPercentText"
                                       Text="--"
                                       Foreground="#F3F6FA"
                                       FontSize="31"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Right"
                                       Margin="0,-5,0,0" />
                        </Grid>
                        <Grid Width="238" Height="10" ClipToBounds="True" Margin="0,1,0,3">
                            <Border Background="#405043" CornerRadius="5" />
                            <Border x:Name="DailyFill" Width="0" HorizontalAlignment="Left" Background="#46EA63" CornerRadius="5" />
                        </Grid>
                        <TextBlock x:Name="DailyResetText" Text="--" Foreground="#747E8D" FontSize="11" Margin="6,0,0,12" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel x:Name="MonthlyQuotaPanel">
                        <Grid Width="238" Margin="0,0,0,2">
                            <TextBlock x:Name="MonthlyLabelText" Text="月额度" Foreground="#F3F6FA" FontSize="20" FontWeight="Bold" />
                            <TextBlock x:Name="MonthlyPercentText"
                                       Text="--"
                                       Foreground="#F3F6FA"
                                       FontSize="31"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Right"
                                       Margin="0,-5,0,0" />
                        </Grid>
                        <Grid Width="238" Height="10" ClipToBounds="True" Margin="0,1,0,3">
                            <Border Background="#405043" CornerRadius="5" />
                            <Border x:Name="MonthlyFill" Width="0" HorizontalAlignment="Left" Background="#46EA63" CornerRadius="5" />
                        </Grid>
                        <TextBlock x:Name="MonthlyResetText" Text="--" Foreground="#747E8D" FontSize="11" Margin="6,0,0,8" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>

            </StackPanel>

            <Grid x:Name="HistoryPanel" Grid.Column="1" Margin="18,2,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="1" x:Name="ChartTitleText" Text="Codex 近 7 天用量"
                           Foreground="#D9E0EA"
                           FontSize="19"
                           FontWeight="Bold"
                           HorizontalAlignment="Left"
                           Margin="0,10,38,0" />
                <StackPanel Grid.Row="0" x:Name="VolcanoBalancePanel" Visibility="Collapsed" Margin="0,7,38,10">
                    <TextBlock Text="火山引擎账户" Foreground="#AEB8C6" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock x:Name="AvailableBalanceText" Text="可用余额 --" Foreground="#F3F6FA" FontSize="17" FontWeight="Bold" Margin="0,5,0,0" />
                    <TextBlock x:Name="CashBalanceText" Text="现金余额 --" Foreground="#AEB8C6" FontSize="12" Margin="0,2,0,0" />
                    <TextBlock x:Name="BalanceErrorText" Foreground="#F0A3A3" FontSize="11" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="45" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,3,0,0" Visibility="Collapsed" />
                    <TextBlock Text="节省计划剩余额度可在火山引擎控制台查看。" Foreground="#7F8A9A" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
                <TextBlock Grid.Row="2" x:Name="TodayTokensText" Text="今日用量 --" Foreground="#AEB8C6"
                           FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,5,0,0"/>
                <TextBlock Grid.Row="2" x:Name="ClockText"
                           Text="--:--"
                           Foreground="#868F9E"
                           FontSize="14"
                           HorizontalAlignment="Right"
                           Margin="0,0,18,0" />
                <TextBlock Grid.Row="2" x:Name="ChartUnitText" Text="单位：百万 Token"
                           Foreground="#868F9E"
                           FontSize="12"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Right"
                           Margin="0,30,18,0" />
                <local:BarChartControl Grid.Row="2" x:Name="Chart" Margin="0,48,0,0" />
                <TextBlock Grid.Row="3" x:Name="StatusText"
                           Text="--"
                           Foreground="#94A1B3"
                           FontSize="11"
                           VerticalAlignment="Bottom"
                           Margin="0,8,0,0"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
            <local:AntigravityPanel x:Name="ModelUsage" Grid.ColumnSpan="2" Margin="0,62,0,0" Visibility="Collapsed"/>
        </Grid>
    </Border>
</Window>
