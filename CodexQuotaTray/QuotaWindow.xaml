<Window x:Class="CodexQuotaTray.QuotaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CodexQuotaTray"
        Title="QuotaTray 额度详情" Width="480" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Foreground="#EEF2F8" ShowInTaskbar="False"
        Topmost="True" ShowActivated="False" UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="Window_OnPreviewKeyDown">
    <Window.Resources>
        <Style x:Key="Subtle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A7B1C2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Range" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#B2BCCB"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chip" CornerRadius="5" Background="Transparent" Padding="8,4">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="#1B2330"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="#2A3546"/>
                                <Setter Property="Foreground" Value="#F3F7FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Close" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#B9C3D3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="5" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#273242"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#F80C0E13" BorderBrush="#41FFFFFF" BorderThickness="1" CornerRadius="17" Padding="15,9,15,10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="×" Width="25" Height="25"
                        Style="{StaticResource Close}" FontSize="19" AutomationProperties.Name="收起详情"
                        Click="CloseButton_OnClick"/>
                <Border x:Name="Header" Background="Transparent" MouseLeftButtonDown="Header_OnMouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal">
                        <Image x:Name="SourceIcon" Width="18" Height="18" Margin="0,0,8,0"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock x:Name="SourceTitleText" Text="Codex" FontWeight="SemiBold"
                                   FontSize="16" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </DockPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="57"/>
                            <ColumnDefinition Width="95"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="QuotaHeading" Text="额度" Style="{StaticResource Subtle}"/>
                        <TextBlock Grid.Column="1" Text="已用" TextAlignment="Right" Style="{StaticResource Subtle}"/>
                        <TextBlock Grid.Column="2" Text="剩余" TextAlignment="Right" Style="{StaticResource Subtle}"/>
                        <TextBlock Grid.Column="3" Text="重置时间" TextAlignment="Right" Style="{StaticResource Subtle}"/>
                    </Grid>
                    <ItemsControl x:Name="QuotaRows">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="26" ToolTip="{Binding Note}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="57"/>
                                        <ColumnDefinition Width="95"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Margin="0,0,5,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="44"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="6" Height="6" Fill="{Binding Tone}"
                                                 HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                                                   FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <Grid Grid.Column="2" Height="4" Margin="4,0,0,0" VerticalAlignment="Center">
                                            <Border Background="#2B3340" CornerRadius="2"/>
                                            <Border Background="{Binding Tone}" CornerRadius="2">
                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleX="{Binding RemainingFraction}"/>
                                                </Border.RenderTransform>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                    <TextBlock Grid.Column="1" Text="{Binding Used}" TextAlignment="Right" Style="{StaticResource Subtle}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Remaining}" Foreground="{Binding Tone}" FontSize="12"
                                               TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Reset}" TextAlignment="Right" Style="{StaticResource Subtle}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border x:Name="VolcanoBalancePanel" Background="#171C26" CornerRadius="7" Padding="8,5"
                            Margin="0,6,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="AvailableBalanceText" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" x:Name="CashBalanceText" TextAlignment="Right"
                                           Style="{StaticResource Subtle}" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                            <TextBlock x:Name="BalanceErrorText" Foreground="#F0AA9E" FontSize="11"
                                       TextTrimming="CharacterEllipsis" Margin="0,3,0,0" Visibility="Collapsed"/>
                            <TextBlock Text="节省计划剩余额度可在火山引擎控制台查看。" Style="{StaticResource Subtle}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border BorderBrush="#2A303B" BorderThickness="0,1,0,0" Margin="0,9,0,0" Padding="0,7,0,0">
                        <StackPanel>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <RadioButton x:Name="RecentRange" Content="24 小时" Style="{StaticResource Range}"
                                                 GroupName="TokenRange" Checked="Range_OnChecked" IsChecked="True"/>
                                    <RadioButton x:Name="WeekRange" Content="7 天" Style="{StaticResource Range}"
                                                 GroupName="TokenRange" Checked="Range_OnChecked"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock x:Name="ChartTitleText" Text="Token 用量" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="ChartSummaryText" Style="{StaticResource Subtle}" Margin="0,1,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>
                            <local:BarChartControl x:Name="Chart" Height="91" Margin="0,5,0,0"
                                                  AutomationProperties.Name="Token 用量柱状图"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <DockPanel Grid.Row="2" Margin="0,7,0,0">
                <TextBlock x:Name="UpdatedText" DockPanel.Dock="Right" Style="{StaticResource Subtle}" Margin="8,0,0,0"/>
                <TextBlock x:Name="StatusText" Style="{StaticResource Subtle}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Grid>
    </Border>
</Window>
