<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>CodexQuotaTray</AssemblyName>
    <RootNamespace>CodexQuotaTray</RootNamespace>
    <Version>0.6.0</Version>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Size</OptimizationPreference>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CodexQuotaCore\CodexQuotaCore.csproj" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.15" />
    <Compile Include="..\CodexQuotaTray\TraySettings.cs" Link="Common\TraySettings.cs" />
    <Compile Include="..\CodexQuotaTray\TrayIconFactory.cs" Link="Common\TrayIconFactory.cs" />
    <Compile Include="..\CodexQuotaTray\QuotaSummary.cs" Link="Common\QuotaSummary.cs" />
    <Compile Include="..\CodexQuotaTray\QuotaDetails.cs" Link="Common\QuotaDetails.cs" />
    <Compile Include="..\CodexQuotaTray\QuotaText.cs" Link="Common\QuotaText.cs" />
    <Compile Include="..\CodexQuotaTray\HudGeometry.cs" Link="Common\HudGeometry.cs" />
    <Compile Include="..\CodexQuotaTray\ReleaseUpdater.cs" Link="Common\ReleaseUpdater.cs" />
    <EmbeddedResource Include="..\CodexQuotaTray\ApplyUpdate.ps1" LogicalName="CodexQuotaTray.ApplyUpdate.ps1" />
    <EmbeddedResource Include="..\CodexQuotaTray\Assets\Providers\NOTICE.txt" LogicalName="CodexQuotaTray.ProviderNotices.txt" />
    <EmbeddedResource Include="..\CodexQuotaTray\Assets\Providers\*.png" LogicalName="CodexQuotaTray.Provider.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
